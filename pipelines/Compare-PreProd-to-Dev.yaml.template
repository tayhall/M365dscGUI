name: 'M365DSC - Compare PreProd to Dev and build MOFs'

trigger: none

# The latest successful run of each export pipeline is used. Dev's tenant, Writer app id and organization are in pipelines/config/Dev.psd1.
resources:
  pipelines:
    - pipeline: preprodExport
      source: '__EXPORT_PREPROD_PIPELINE__'
    - pipeline: devExport
      source: '__EXPORT_DEV_PIPELINE__'

parameters:
  - name: mofLayout
    displayName: MOF layout (Combined = one Changes + one Removals; PerWorkload = a pair per workload, applied in stages)
    type: string
    default: Combined
    values:
      - Combined
      - PerWorkload
  - name: completeWorkloads
    displayName: Workloads the Dev export covers completely (an empty type then counts as empty, so PreProd objects become Missing)
    type: string
    default: 'AAD,Intune,EXO,Teams'

pool:
  name: '__POOL__'   # needs pwsh 7.6+ and local admin

jobs:
  - job: CompareAndBuild
    steps:
      - checkout: self
      - download: preprodExport
        artifact: PreProdExport
      - download: devExport
        artifact: DevExport

      - pwsh: |
          & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Install-PipelineDependencies.ps1'
        displayName: Install PowerShell modules

      - task: AzurePowerShell@5
        displayName: Compare PreProd to Dev and build MOFs
        inputs:
          azureSubscription: '__DEV_SERVICE_CONNECTION__'
          azurePowerShellVersion: LatestVersion
          pwsh: true
          ScriptType: InlineScript
          Inline: |
            & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Invoke-PipelineCompare.ps1' `
                -SourceExportPath '$(Pipeline.Workspace)/preprodExport/PreProdExport' `
                -TargetExportPath '$(Pipeline.Workspace)/devExport/DevExport' `
                -OutputPath '$(Build.ArtifactStagingDirectory)/compare' `
                -MofLayout '${{ parameters.mofLayout }}' -CompleteWorkloads $env:PE_COMPLETE_WORKLOADS `
                -PreProdRun $env:PE_PREPROD_RUN -DevRun $env:PE_DEV_RUN
        env:
          PE_COMPLETE_WORKLOADS: ${{ parameters.completeWorkloads }}
          PE_PREPROD_RUN: $(resources.pipeline.preprodExport.runID)
          PE_DEV_RUN: $(resources.pipeline.devExport.runID)

      # The drift report and the generated configuration, for review and for Apply-Dev.
      - publish: $(Build.ArtifactStagingDirectory)/compare
        artifact: DriftReport
