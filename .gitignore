# Local reference clone of upstream (clone separately: https://github.com/Microsoft365DSC/Microsoft365DSC)
Microsoft365DSC/

# Visual brainstorming companion output
.superpowers/

# Never commit certificates or keys
*.pfx
*.cer
*.key

# Exports contain tenant data
/data/
# Safety net: never allow data folders under src or tools
/src/data/
/tools/data/

# Browser tool scratch (Playwright)
.playwright-mcp/

# Pipeline environment values and the YAML generated from them
pipelines/pipeline.settings.psd1
# Generated pipeline YAML (from the .yaml.template files). In the ADO repo DELETE the next line: there the generated YAML is committed.
pipelines/*.yaml
