# One series of runs per workload: Dev-Full-v1, Dev-AAD-v1 ... each counts on its own. Tenant-Changes compares a run with the one before it in its series.
name: 'Dev-${{ parameters.workload }}-v$(Rev:r)'

trigger: none

# Dev's tenant, Key Vault and app id are in pipelines/config/Dev.psd1, read by the script.
parameters:
  - name: workload
    displayName: 'What to export: Full (every default workload) or one workload'
    type: string
    default: Full
    values:
      __WORKLOAD_CHOICES__

pool:
  name: '__POOL__'   # needs pwsh 7.6+ and local admin

jobs:
  - job: ExportDev
    timeoutInMinutes: 180
    steps:
      - checkout: self

      - pwsh: |
          & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Install-PipelineDependencies.ps1'
        displayName: Install PowerShell modules

      - task: AzurePowerShell@5
        displayName: Export Dev
        inputs:
          azureSubscription: '__DEV_SERVICE_CONNECTION__'
          azurePowerShellVersion: LatestVersion
          pwsh: true
          ScriptType: InlineScript
          Inline: |
            & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Invoke-PipelineExport.ps1' -Environment Dev -OutputPath '$(Build.ArtifactStagingDirectory)/export'
        env:
          PE_WORKLOAD: ${{ parameters.workload }}

      - pwsh: |
          & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Disconnect-PipelineTenant.ps1' -Slug dev -Role Reader
        displayName: Remove the certificate from the agent (always runs)
        condition: always()

      - publish: $(Build.ArtifactStagingDirectory)/export
        artifact: DevExport
