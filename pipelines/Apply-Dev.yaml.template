name: 'M365DSC - Apply compared MOF files to Dev'

trigger: none

# Applies what "Compare PreProd to Dev and build MOFs" produced (source Compare), or the revert of a "Tenant changes" run of Dev (source
# TenantChanges: puts Dev back to its previous export). DEV ONLY: the target is fixed in the script, and a tenant-changes run of another
# tenant is refused. Dev's tenant and Writer app id are in pipelines/config/Dev.psd1.
# Both pipelines are listed in the run form; the one the source parameter does not name is ignored.
resources:
  pipelines:
    - pipeline: compare
      source: '__COMPARE_PIPELINE__'
    - pipeline: tenantChanges
      source: '__TENANT_CHANGES_PIPELINE__'

parameters:
  - name: source
    displayName: 'Compare = the MOF files of a PreProd-to-Dev compare run; TenantChanges = the revert of a Tenant changes run of Dev'
    type: string
    default: Compare
    values:
      - Compare
      - TenantChanges
  - name: mode
    displayName: Test only reports what would change; Apply changes Dev
    type: string
    default: Test
    values:
      - Test
      - Apply
  - name: workloads
    displayName: 'Workload prefixes to apply, in this order (for example AAD,Intune,EXO,Teams). Leave empty for a Combined compare run.'
    type: string
    default: ''
  - name: includeRemovals
    displayName: Also apply Removals (deletes objects in Dev that PreProd does not have)
    type: boolean
    default: false

pool:
  name: '__POOL__'   # needs pwsh 7.6+ and local admin

jobs:
  # An approval and check on the environment '__DEV_ENVIRONMENT__' is the gate before anything is written.
  - deployment: ApplyToDev
    environment: '__DEV_ENVIRONMENT__'
    strategy:
      runOnce:
        deploy:
          steps:
            - checkout: self
            - ${{ if eq(parameters.source, 'TenantChanges') }}:
              - download: tenantChanges
                artifact: TenantChanges
            - ${{ else }}:
              - download: compare
                artifact: DriftReport

            - pwsh: |
                & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Install-PipelineDependencies.ps1'
              displayName: Install PowerShell modules

            - task: AzurePowerShell@5
              displayName: '${{ parameters.mode }} MOF files on Dev'
              inputs:
                azureSubscription: '__DEV_SERVICE_CONNECTION__'
                azurePowerShellVersion: LatestVersion
                pwsh: true
                ScriptType: InlineScript
                Inline: |
                  & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Invoke-PipelineApply.ps1' `
                      -ReportPath $env:PE_REPORT_PATH -RequireTenant:($env:PE_REQUIRE_TENANT -eq 'True') `
                      -Mode '${{ parameters.mode }}' -Workloads $env:PE_WORKLOADS -IncludeRemovals '${{ parameters.includeRemovals }}' -CompareRun $env:PE_COMPARE_RUN
              env:
                PE_WORKLOADS: ${{ parameters.workloads }}
                ${{ if eq(parameters.source, 'TenantChanges') }}:
                  PE_REPORT_PATH: '$(Pipeline.Workspace)/tenantChanges/TenantChanges/Revert'
                  PE_REQUIRE_TENANT: 'True'
                  PE_COMPARE_RUN: $(resources.pipeline.tenantChanges.runID)
                ${{ else }}:
                  PE_REPORT_PATH: '$(Pipeline.Workspace)/compare/DriftReport'
                  PE_REQUIRE_TENANT: 'False'
                  PE_COMPARE_RUN: $(resources.pipeline.compare.runID)

            - pwsh: |
                & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Disconnect-PipelineTenant.ps1' -Slug dev -Role Writer
              displayName: Remove the certificate from the agent (always runs)
              condition: always()
