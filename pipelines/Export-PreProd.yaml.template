name: 'PreProd-export-v$(Rev:r)'

trigger: none

# PreProd's tenant, Key Vault and app id are in pipelines/config/PreProd.psd1, read by the script.
parameters:
  __EXPORT_WORKLOAD_PARAMETERS__

pool:
  name: '__POOL__'   # needs pwsh 7.6+ and local admin

jobs:
  - job: ExportPreProd
    timeoutInMinutes: 180
    steps:
      - checkout: self

      - pwsh: |
          & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Install-PipelineDependencies.ps1'
        displayName: Install PowerShell modules

      - task: AzurePowerShell@5
        displayName: Export PreProd
        inputs:
          azureSubscription: '__PREPROD_SERVICE_CONNECTION__'
          azurePowerShellVersion: LatestVersion
          pwsh: true
          ScriptType: InlineScript
          Inline: |
            & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Invoke-PipelineExport.ps1' -Environment PreProd -OutputPath '$(Build.ArtifactStagingDirectory)/export'
        env:
          __WORKLOAD_ENV__

      - pwsh: |
          & '$(Build.SourcesDirectory)/__REPO_FOLDER__/pipelines/scripts/Disconnect-PipelineTenant.ps1' -Slug preprod -Role Reader
        displayName: Remove the certificate from the agent (always runs)
        condition: always()

      - publish: $(Build.ArtifactStagingDirectory)/export
        artifact: PreProdExport
